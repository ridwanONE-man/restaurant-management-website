# =============================================================================
# GRILL & GRAIN — Supabase / Database credentials
# =============================================================================
# 1. Copy this file to `.env`  (or fill `.env` directly — same keys)
# 2. Paste your Project URL, anon key, and service role key from Supabase:
#    Project Settings → API
# 3. Restart `npm run dev` after saving
# =============================================================================

# Public project URL  (safe for the browser app)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anon (publishable) key  (safe for the browser app)
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# Admin service role key  — SERVER / ADMIN ONLY
# NEVER prefix with VITE_  (must not ship to the browser)
# Use later for secure admin scripts, Edge Functions, or a backend
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
